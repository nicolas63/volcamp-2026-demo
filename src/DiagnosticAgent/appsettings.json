{
  "MCP_ENDPOINT": "http://localhost:5103/mcp",
  "AgentGuard": {
    "MaxDurationSeconds": 90,
    "MaxTotalTokens": 60000,
    "MaxCostUsd": 0.05,
    "MaxToolCalls": 8,
    "Profiles": {
      "Strict": {
        "MaxTotalTokens": 8000,
        "MaxToolCalls": 2
      }
    },
    "GlobalBudget": {
      "Enabled": true,
      "MaxCostUsdPerHour": 0.50,
      "PrometheusBaseUrl": "http://localhost:9090",
      "FailOpen": true,
      "TimeoutSeconds": 3
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
